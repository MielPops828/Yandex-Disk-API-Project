<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="YandexDiskAPISuite" thread-count="8" parallel="methods">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Yandex Disk API Tests">
        <classes>
            <class name="tests.AuthOnDiskTest"/>
            <class name="tests.CreateFolderTest"/>
            <class name="tests.DeleteFolderTest"/>
            <class name="tests.RestoreFolderTest"/>
            <class name="tests.AsyncDeleteFolderTest"/>
            <class name="tests.AsyncRestoreFolderTest"/>
            <class name="tests.UploadAndCopyFileTest"/>
            <class name="tests.DownloadFileTest"/>
        </classes>
    </test>
</suite>